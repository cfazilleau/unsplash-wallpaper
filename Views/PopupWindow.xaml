<Window x:Class="UnsplashWallpaper.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UnsplashWallpaper.ViewModels"
        Title="Unsplash Wallpaper"
        Width="460" Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#FF1B1B1F">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:PathToImageConverter x:Key="PathToImage" />

        <!-- Dark palette -->
        <SolidColorBrush x:Key="WindowBg" Color="#FF1B1B1F" />
        <SolidColorBrush x:Key="CardBg" Color="#FF26262C" />
        <SolidColorBrush x:Key="InputBg" Color="#FF2E2E36" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FF3C3C46" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFECECEC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9A9AA5" />
        <SolidColorBrush x:Key="Accent" Color="#FF5B78E8" />
        <SolidColorBrush x:Key="AccentHover" Color="#FF6E88EE" />
        <SolidColorBrush x:Key="LinkBrush" Color="#FF89A6FF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,12,0,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- Primary action buttons -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hyperlink-style button -->
        <Style TargetType="Button" x:Key="LinkButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource LinkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"
                                   Foreground="{TemplateBinding Foreground}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon button (bottom bar) -->
        <Style TargetType="Button" x:Key="IconButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button (red hover) -->
        <Style TargetType="Button" x:Key="CloseButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE81123" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox (dark) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource InputBg}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" Data="M0,0 L4,4 L8,0 Z"
                                                  Fill="{StaticResource TextSecondary}" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{StaticResource TextPrimary}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" MaxHeight="240"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl / TabItem (dark) -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Padding="14,7" Margin="0,0,4,0" CornerRadius="5,5,0,0"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardBg}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#FF222228" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox items (history) -->
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource WindowBg}">
        <!-- Custom title bar (replaces the OS chrome) -->
        <Border DockPanel.Dock="Top" Background="#FF212127" Height="34"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Unsplash Wallpaper" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                        Click="CloseButton_Click" ToolTip="Close">
                    <Path Width="11" Height="11" Stretch="Uniform" Data="M0,0 L11,11 M11,0 L0,11"
                          Stroke="{StaticResource TextPrimary}" StrokeThickness="1.4" />
                </Button>
            </Grid>
        </Border>

        <!-- Bottom bar: status text + small Next/Pause icon buttons -->
        <Border DockPanel.Dock="Bottom" Background="#FF212127" Padding="10,4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Command="{Binding NextWallpaperCommand}"
                            IsEnabled="{Binding IsNotBusy}" ToolTip="Next wallpaper">
                        <Path Width="14" Height="12" Stretch="Uniform"
                              Data="M0,0 L6,6 L0,12 Z M6,0 L12,6 L6,12 Z M12.5,0 H14 V12 H12.5 Z"
                              Fill="{StaticResource TextPrimary}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding TogglePauseCommand}"
                            ToolTip="{Binding PauseButtonText}">
                        <Grid Width="12" Height="12">
                            <Path Stretch="Uniform" Data="M0,0 H3.5 V12 H0 Z M6.5,0 H10 V12 H6.5 Z"
                                  Fill="{StaticResource TextPrimary}"
                                  Visibility="{Binding NotPaused, Converter={StaticResource BoolToVis}}" />
                            <Path Stretch="Uniform" Data="M0,0 L11,6 L0,12 Z"
                                  Fill="{StaticResource TextPrimary}"
                                  Visibility="{Binding Paused, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="6,6,6,0" Background="Transparent" BorderThickness="0">

            <!-- ================= CURRENT ================= -->
            <TabItem Header="Current">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CardBg}">
                    <StackPanel Margin="12">
                        <Border Background="#FF33333B" CornerRadius="5" Height="230"
                                HorizontalAlignment="Stretch">
                            <Image Stretch="UniformToFill"
                                   Source="{Binding Current.LocalPath, Converter={StaticResource PathToImage}}" />
                        </Border>

                        <TextBlock Style="{StaticResource Label}" Text="PHOTOGRAPHER" />
                        <TextBlock Text="{Binding Current.PhotographerName}" FontSize="15" />
                        <Button Style="{StaticResource LinkButton}" Margin="0,3,0,0"
                                Content="View photographer on Unsplash"
                                Command="{Binding OpenUrlCommand}"
                                CommandParameter="{Binding Current.AttributedProfileUrl}" />

                        <TextBlock Style="{StaticResource Label}" Text="DESCRIPTION" />
                        <TextBlock Text="{Binding Current.Description}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}" />

                        <Button Style="{StaticResource LinkButton}" Margin="0,12,0,0"
                                Content="Open this photo on Unsplash"
                                Command="{Binding OpenUrlCommand}"
                                CommandParameter="{Binding Current.AttributedPhotoUrl}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= SETTINGS ================= -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CardBg}">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource Label}" Text="UNSPLASH ACCESS KEY" />
                        <PasswordBox x:Name="AccessKeyBox" PasswordChanged="AccessKeyBox_PasswordChanged" />
                        <Button Style="{StaticResource LinkButton}" Margin="0,4,0,0"
                                Content="Get a free key at unsplash.com/developers"
                                Command="{Binding OpenDevPortalCommand}" />

                        <TextBlock Style="{StaticResource Label}" Text="IMAGE SOURCE" />
                        <ComboBox ItemsSource="{Binding SourceModes}" SelectedItem="{Binding SourceMode}" />

                        <StackPanel Visibility="{Binding ShowSearch, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Label}" Text="SEARCH TERMS (COMMA SEPARATED)" />
                            <TextBox Text="{Binding SearchTerms, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowTopics, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Label}" Text="TOPIC SLUGS (E.G. WALLPAPERS, NATURE)" />
                            <TextBox Text="{Binding TopicSlugs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowCollections, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Label}" Text="COLLECTION IDS (COMMA SEPARATED)" />
                            <TextBox Text="{Binding CollectionIds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Label}" Text="ORIENTATION" />
                        <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}" />

                        <TextBlock Style="{StaticResource Label}" Text="CHANGE EVERY (MINUTES)" />
                        <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="60 = hourly · 1440 = daily · 10080 = weekly"
                                   FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />

                        <TextBlock Style="{StaticResource Label}" Text="FIT STYLE" />
                        <ComboBox ItemsSource="{Binding WallpaperStyles}" SelectedItem="{Binding WallpaperStyle}" />

                        <CheckBox Content="Run at Windows startup" Margin="0,16,0,0"
                                  IsChecked="{Binding RunAtStartup}" />

                        <TextBlock Text="Changes are saved automatically." FontSize="11" FontStyle="Italic"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= HISTORY ================= -->
            <TabItem Header="History">
                <ListBox ItemsSource="{Binding History}" Background="{StaticResource CardBg}"
                         BorderThickness="0" Padding="6"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6" Margin="0,3" Background="{StaticResource InputBg}" CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#FF33333B" CornerRadius="3"
                                            Height="56" Width="84">
                                        <Image Stretch="UniformToFill"
                                               Source="{Binding ThumbPath, Converter={StaticResource PathToImage}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PhotographerName}" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AppliedUtc, StringFormat=Applied {0:g} UTC}"
                                                   FontSize="10" Foreground="#FF77777F" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Set again" VerticalAlignment="Center"
                                            Padding="10,5" FontWeight="Normal"
                                            Command="{Binding DataContext.ReapplyCommand,
                                                       RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
